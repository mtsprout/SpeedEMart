end

-- spawn pad (staff side)
do
	local sp = new("SpawnLocation", {
		Name = "StaffSpawn",
		Anchored = true,
		Size = Vector3.new(6, 0.2, 4),
		CFrame = CFrame.new(0, FY + 0.1, -1.2) * CFrame.Angles(0, math.pi, 0),
